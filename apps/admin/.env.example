# Used by the auth bridge — must match Express's session config exactly.
SESSION_COOKIE_NAME=connect.sid
SESSION_SECRET=<same as the Express app>
REDIS_URL=redis://localhost:6379

# Used by @eve/db pool.
DATABASE_URL=postgres://eve:eve@localhost:5432/eve_development

# Used by @eve/storage. Same env contract as the Express app — STORAGE_BACKEND
# defaults to 'local'. In admin dev this writes into the repo-root public/uploads
# folder because Express serves those files to the mobile app on :3000.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=../../public/uploads
STORAGE_LOCAL_URL_PREFIX=http://localhost:3000/uploads

# Public Express API, used to build Google photo proxy URLs for the admin's
# image fallbacks. Leave unset in prod: Express serves /api on the same origin.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Claude key for the place form's "Generate editorial" button (POST /api/admin/generate).
# Server only; leave blank to turn the feature off (the route answers 503).
ANTHROPIC_API_KEY=
